# Example Databricks Connection Profile for dbt Core
databricks_lakehouse:
  target: dev
  outputs:
    dev:
      type: databricks
      catalog: main
      schema: banking_analytics
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      threads: 4
